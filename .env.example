# =============================================================================
# Hospital & Pharmacy Management System (HMS) - On-Premise Environment Template
# =============================================================================
# Copy this file to .env before starting:
#   Linux/macOS : cp .env.example .env
#   Windows     : copy .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=hms_secure_pass_2026
POSTGRES_DB=hms
POSTGRES_PORT=5432

# Connection string used by host-side tools / scripts (pointing to localhost:5432)
# Inside Docker containers, the app connects automatically to host 'postgres:5432'
DATABASE_URL="postgresql://postgres:hms_secure_pass_2026@localhost:5432/hms?schema=public"

# -----------------------------------------------------------------------------
# NextAuth / Application Authentication
# -----------------------------------------------------------------------------
# Host port exposed on the server
APP_PORT=3000

# NextAuth URL:
# For local server access only:
NEXTAUTH_URL="http://localhost:3000"

# FOR HOSPITAL LOCAL NETWORK (LAN / Intranet):
# Replace localhost with the server's static LAN IP address (e.g. 192.168.1.34)
# so that Reception, Doctor cabins, and Pharmacy terminals can log in:
# NEXTAUTH_URL="http://192.168.1.34:3000"

# Secret key used to encrypt session cookies & JWT tokens (min 32 characters)
NEXTAUTH_SECRET="hospital-management-system-super-secret-key-2026"

# -----------------------------------------------------------------------------
# Workstation Terminal IP & Domain Restrictions
# -----------------------------------------------------------------------------
# Master toggle: set to "true" to enforce IP/domain rules, or "false" to disable
PORTAL_IP_RESTRICTIONS_ENABLED=true

# Allowed Workstation IP addresses per Department Portal
# Format: comma-separated list of exact IPs, CIDR subnets (e.g. 192.168.1.0/24), or "*" to allow all
ALLOWED_IPS_ADMIN="127.0.0.1,::1,localhost,192.168.1.34"
ALLOWED_IPS_RECEPTIONIST="*"
ALLOWED_IPS_DOCTOR="*"
ALLOWED_IPS_PHARMACIST="*"

# Allowed Domains / Hostnames per Portal (Optional, "*" allows access by direct IP or any hostname)
# Example: ALLOWED_DOMAINS_ADMIN="admin.hospital.local"
ALLOWED_DOMAINS_ADMIN="*"
ALLOWED_DOMAINS_RECEPTIONIST="*"
ALLOWED_DOMAINS_DOCTOR="*"
ALLOWED_DOMAINS_PHARMACIST="*"

# -----------------------------------------------------------------------------
# Biometric Scanner Configuration (Optional)
# -----------------------------------------------------------------------------
BIOMETRIC_ADAPTER_TYPE="mock"
BIOMETRIC_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
BIOMETRIC_AGENT_URL="http://127.0.0.1:9099"
BIOMETRIC_AGENT_TOKEN="Ruqayya-scanner-agent-pairing-token-2026"
