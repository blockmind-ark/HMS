# ==============================================================================
# Hospital & Pharmacy Management System (HMS) - Production Environment Settings
# ==============================================================================
# Copy this file to .env.prod if you want to override default production credentials:
#   cp .env.prod.example .env.prod
# ==============================================================================

# Database Configuration (PostgreSQL 15 Container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=hms_prod_secure_pass_2026!
POSTGRES_DB=hms_prod

# Web Application Port & URL
APP_PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=hms_prod_nextauth_jwt_secret_key_84920491_2026

# Biometric Scanner Configuration (On-Premise USB / LAN Scanner Daemon)
BIOMETRIC_ADAPTER_TYPE=local_service
BIOMETRIC_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
BIOMETRIC_AGENT_URL=http://127.0.0.1:9099
BIOMETRIC_AGENT_TOKEN=Ruqayya-scanner-agent-pairing-token-2026

# Workstation & Subnet Access Policies
PORTAL_IP_RESTRICTIONS_ENABLED=false
ALLOWED_IPS_ADMIN=*
ALLOWED_IPS_RECEPTIONIST=*
ALLOWED_IPS_DOCTOR=*
ALLOWED_IPS_PHARMACIST=*
ALLOWED_DOMAINS_ADMIN=*
ALLOWED_DOMAINS_RECEPTIONIST=*
ALLOWED_DOMAINS_DOCTOR=*
ALLOWED_DOMAINS_PHARMACIST=*

