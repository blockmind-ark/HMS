# ==============================================================================
# Hospital & Pharmacy Management System (HMS) - Production Database Image
# ==============================================================================
# Pre-configured PostgreSQL 15-alpine with Day-1 production schema & master catalog
# ==============================================================================

FROM postgres:15-alpine

LABEL maintainer="Ruqayya Medical Center & Pharmacy Management System"
LABEL description="Pre-seeded PostgreSQL 15 Database Image for HMS Production"

ENV POSTGRES_DB=hms_prod \
    POSTGRES_USER=postgres \
    POSTGRES_PASSWORD=hms_prod_secure_pass_2026!

# Automatically executed by PostgreSQL entrypoint on first volume initialization
COPY docker/initdb/01-init.sql /docker-entrypoint-initdb.d/01-init.sql

EXPOSE 5432

